# The store. Same domain the CS agent uses; different app.
SHOPIFY_SHOP_DOMAIN=aflalo.myshopify.com

# The portal's OWN Shopify app ('inventory-portal'), Dev Dashboard client credentials.
# Scopes: write_inventory, read_inventory, read_products, read_locations, read_draft_orders.
PORTAL_SHOPIFY_API_KEY=
PORTAL_SHOPIFY_API_SECRET=

# Which Shopify location pulls come from (the store has NYC, SAMPLE SALE, Wholesale).
PORTAL_LOCATION_NAME=NYC

# Airtable personal access token with access to the 'AFLALO Inventory Pulls' base, and that base's id.
AIRTABLE_TOKEN=
PULLS_AIRTABLE_BASE=
